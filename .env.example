# Copie este arquivo para `.env` e preencha com suas credenciais.
#   cp .env.example .env        (Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# O `.env` está no .gitignore e NUNCA deve ser commitado.

# --- TMDB ---------------------------------------------------------------
# Chave gratuita em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Banco de dados -----------------------------------------------------
# Postgres gerenciado (Supabase / Neon).
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# --- Supabase (storage de pôsteres) -------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- Comportamento do pipeline ------------------------------------------
# Diretório local dos snapshots brutos (fora do git).
DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
